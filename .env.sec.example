# ============================================================
# SEC — Secretaría de Control
# Production environment configuration
# ============================================================
# This file is the deployment template for SEC instances.
# Copy to .env and replace all CHANGE_ME values with real secrets.
# IMPORTANT: .env is in .gitignore — never commit real secrets.
# ============================================================

# ============================================================
# Django Core Configuration
# ============================================================
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_50_PLUS_CHAR_STRING
DJANGO_ALLOWED_HOSTS=sec-backoffice.sfelipe.gob.mx
TESTING=False

# ============================================================
# Database Configuration
# ============================================================
# Main PostgreSQL connection — same server, different schemas
POSTGRESQL_DB_URL=postgres://sec_user:CHANGE_ME@db-host:5432/backoffice_tramites
BACKOFFICE_DB_SCHEMA=backoffice
BACKEND_DB_SCHEMA=public

# ============================================================
# Security Settings (Production — hardened)
# ============================================================
DJANGO_SECURE_CONTENT_TYPE_NOSNIFF=True
DJANGO_SECURE_BROWSER_XSS_FILTER=True
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True

# ============================================================
# Content Security Policy (CSP)
# ============================================================
# Start in report-only mode to tune before enforcing
DJANGO_CSP_REPORT_ONLY=True

# ============================================================
# CSRF Configuration
# ============================================================
DJANGO_CSRF_TRUSTED_ORIGINS=https://sec-backoffice.sfelipe.gob.mx

# ============================================================
# Session Configuration
# ============================================================
DJANGO_SESSION_COOKIE_AGE=3600

# ============================================================
# Pagination
# ============================================================
DJANGO_DEFAULT_PAGE_SIZE=25

# ============================================================
# Email Configuration
# ============================================================
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=CHANGE_ME_SMTP_HOST
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_HOST_USER=CHANGE_ME_EMAIL_USER
DJANGO_EMAIL_HOST_PASSWORD=CHANGE_ME_EMAIL_PASSWORD
DJANGO_DEFAULT_FROM_EMAIL=sec-backoffice@sanfelipe.gob.mx

# ============================================================
# Timezone
# ============================================================
DJANGO_TIME_ZONE=America/Tijuana

# ============================================================
# Tenancy / Department Configuration
# ============================================================
ACTIVE_DEPARTMENT=SEC

# SEC branding
BACKOFFICE_SITE_TITLE="Secretaría de Control"
BACKOFFICE_SITE_HEADER="San Felipe"
BACKOFFICE_SITE_BRAND="Backoffice — Secretaría de Control"
BACKOFFICE_SITE_LOGO=

# SEC content
BACKOFFICE_WELCOME_SIGN="Secretaría de Control — Municipio de San Felipe"
BACKOFFICE_COPYRIGHT="Municipio de San Felipe — Todos los derechos reservados"

# ============================================================
# Workflow Configuration
# ============================================================
# Disable EN_DILIGENCIA (estatus 205) for SEC
DISABLED_TRANSITIONS=205

# ============================================================
# Session Isolation (Multi-Instance)
# ============================================================
# Unique cookie names prevent session collisions when
# DAU and SEC run on the same domain
SESSION_COOKIE_NAME=sec_sessionid
CSRF_COOKIE_NAME=sec_csrftoken

# ============================================================
# SFTP Storage Configuration
# ============================================================
SFTP_HOST=CHANGE_ME_SFTP_HOST
SFTP_PORT=22
SFTP_USERNAME=sec_sftp_user
SFTP_PASSWORD=
SFTP_PRIVATE_KEY_PATH=/app/.ssh/id_ed25519
SFTP_PRIVATE_KEY_PASSPHRASE=

# REQUIRED in production — obtain with:
#   ssh-keyscan -t ed25519 <host>
SFTP_HOST_KEY=CHANGE_ME_SSH_HOST_KEY

SFTP_BASE_DIR=/sec/tramites
SFTP_PDF_DIR=pdfs
SFTP_CACHE_DIR=/app/.sftp_cache
SFTP_CACHE_TTL=3600
SFTP_CACHE_MAX_SIZE_MB=500
